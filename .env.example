# RCAFT Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.

# Application URL (for generating dynamic QR codes and callback URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public & Private Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Feature Flags
# Set to 'true' only if approved after human policy review
ENABLE_AI_REVIEW_ASSIST="false"

# Optional AI Provider (only used when ENABLE_AI_REVIEW_ASSIST="true")
# Supported values: 'gemini' | 'openai'
AI_PROVIDER="gemini"
AI_PROVIDER_API_KEY="your-ai-api-key"
